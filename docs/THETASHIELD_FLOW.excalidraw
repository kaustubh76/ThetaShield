   "versionNonce": 1559635248,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "The authority boundary \u2014 the answer to the obvious question",
   "originalText": "The authority boundary \u2014 the answer to the obvious question",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ts0262",
   "type": "text",
   "x": 2364,
   "y": 2250.0,
   "width": 667.6800000000001,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ts0259"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1559739977,
   "version": 1,
   "versionNonce": 1559739977,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "CIRCLE decides what is authentic. REACTIVE decides when eligible work runs. Neither computes a fee, holds a\ntoken, or can stop a swap. The executor Reactive calls is permissionless and cannot install controller\nstate; the controller only ever believes a finalized Circle message from a sealed peer.\n\nSo the worst a failed scheduler can do is make the pool cheap and forgetful \u2014 which is exactly what a pool\nwith no memory already is.",
   "originalText": "CIRCLE decides what is authentic. REACTIVE decides when eligible work runs. Neither computes a fee, holds a\ntoken, or can stop a swap. The executor Reactive calls is permissionless and cannot install controller\nstate; the controller only ever believes a finalized Circle message from a sealed peer.\n\nSo the worst a failed scheduler can do is make the pool cheap and forgetful \u2014 which is exactly what a pool\nwith no memory already is.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ts0263",
   "type": "text",
   "x": 2364,
   "y": 2346.0,
   "width": 415.8,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ts0259"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1559844706,
   "version": 1,
   "versionNonce": 1559844706,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "two planes, two authorities, neither able to do the other's job",
   "originalText": "two planes, two authorities, neither able to do the other's job",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
