   "seed": 1555236630,
   "version": 1,
   "versionNonce": 1555236630,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "EXPIRED \u2014 the reference selection window is 3600s, not the\n7200s lifetime. Past it no sample can fall inside the scoring\nrange, so no keeper can rescue it. This is the exact failure\nthe scheduler exists to prevent, and it happened for real\nonce.\nDROPPED \u2014 queue capacity, invalid markout, or epoch capacity.\nCOLD START \u2014 scored, but structurally unable to move a fee.",
   "originalText": "EXPIRED \u2014 the reference selection window is 3600s, not the\n7200s lifetime. Past it no sample can fall inside the scoring\nrange, so no keeper can rescue it. This is the exact failure\nthe scheduler exists to prevent, and it happened for real\nonce.\nDROPPED \u2014 queue capacity, invalid markout, or epoch capacity.\nCOLD START \u2014 scored, but structurally unable to move a fee.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
