   "version": 1,
   "versionNonce": 1566128446,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "the economics are the synthetic holdout study; the machine is this trace",
   "originalText": "the economics are the synthetic holdout study; the machine is this trace",
   "fontSize": 11,
   "fontFamily": 3,
