   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "the non-baseline directional transition is proven in the lifecycle suite, not yet in a second public\ncycle",
   "originalText": "the non-baseline directional transition is proven in the lifecycle suite, not yet in a second public\ncycle",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
