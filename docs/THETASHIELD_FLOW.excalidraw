  {
   "id": "ts0028",
   "type": "text",
   "x": 104,
   "y": 311.5,
   "width": 1241.76,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ts0025"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1535233391,
   "version": 1,
   "versionNonce": 1535233391,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "A pool has to price a swap before it can know whether that swap was fair. ThetaShield lets it find out afterwards: it measures what past flow actually did to LPs, subtracts ordinary noise, and raises\nthe fee only for the direction that persistent evidence says was harmful. The other direction stays at the baseline.",
   "originalText": "A pool has to price a swap before it can know whether that swap was fair. ThetaShield lets it find out afterwards: it measures what past flow actually did to LPs, subtracts ordinary noise, and raises\nthe fee only for the direction that persistent evidence says was harmful. The other direction stays at the baseline.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ts0029",
   "type": "text",
   "x": 104,
   "y": 347.5,
   "width": 534.6,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ts0025"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1535338120,
   "version": 1,
   "versionNonce": 1535338120,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "not a blacklist \u00b7 not an identity score \u00b7 not a delay \u00b7 never custody of the swap",
   "originalText": "not a blacklist \u00b7 not an identity score \u00b7 not a delay \u00b7 never custody of the swap",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
