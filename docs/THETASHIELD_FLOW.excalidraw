   "link": null,
   "locked": false,
   "text": "The claim boundary, stated up front",
   "originalText": "The claim boundary, stated up front",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ts0033",
   "type": "text",
   "x": 1408,
   "y": 311.5,
   "width": 1235.52,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ts0030"
   ],
