   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "Back on Unichain Sepolia. The interesting half of this band is the red half: a system that decides fees is only as trustworthy as the things it declines to believe.",
   "originalText": "Back on Unichain Sepolia. The interesting half of this band is the red half: a system that decides fees is only as trustworthy as the things it declines to believe.",
