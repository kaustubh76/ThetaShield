   "versionNonce": 1565395343,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "Why the fee stayed at 5.00 bps \u2014 and why that is the result",
   "originalText": "Why the fee stayed at 5.00 bps \u2014 and why that is the result",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ts0317",
   "type": "text",
   "x": 880,
   "y": 3004.25,
   "width": 661.44,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ts0314"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1565500072,
   "version": 1,
   "versionNonce": 1565500072,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "minimumTrailingObservations is 16 PER SIDE. The pool has settled two observations across both sides in its\nlife, so confidence is structurally zero and no premium is reachable. The first live safety decision this\nsystem ever made was refusing to move a fee off one sample.\n\nA mechanism that repriced a pool from a single observation would demo better and be trivial to manipulate.",
   "originalText": "minimumTrailingObservations is 16 PER SIDE. The pool has settled two observations across both sides in its\nlife, so confidence is structurally zero and no premium is reachable. The first live safety decision this\nsystem ever made was refusing to move a fee off one sample.\n\nA mechanism that repriced a pool from a single observation would demo better and be trivial to manipulate.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ts0318",
   "type": "text",
   "x": 880,
   "y": 3085.25,
   "width": 660.0,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
