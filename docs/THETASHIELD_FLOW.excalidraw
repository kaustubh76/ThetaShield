   "text": "What this band costs the trader",
   "originalText": "What this band costs the trader",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ts0108",
   "type": "text",
   "x": 2732,
   "y": 893.0,
   "width": 1198.08,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ts0105"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1543611711,
   "version": 1,
   "versionNonce": 1543611711,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "Two storage reads and an event \u2014 33,192 gas in beforeSwap and 166,781 in a warm afterSwap, measured in isolated local EVM calls under a pinned profile, not quoted from a live chain. Everything\nin bands 2 and 3 updates LATER swaps; none of it is on the path of this one. That is the whole reason the delayed processor is allowed to be slow, stateful and expensive without anyone\nnoticing.",
   "originalText": "Two storage reads and an event \u2014 33,192 gas in beforeSwap and 166,781 in a warm afterSwap, measured in isolated local EVM calls under a pinned profile, not quoted from a live chain. Everything\nin bands 2 and 3 updates LATER swaps; none of it is on the path of this one. That is the whole reason the delayed processor is allowed to be slow, stateful and expensive without anyone\nnoticing.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ts0109",
   "type": "text",
   "x": 2732,
   "y": 944.0,
   "width": 356.4,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ts0105"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1543716440,
   "version": 1,
   "versionNonce": 1543716440,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "no second chain is ever in the critical path of a swap",
   "originalText": "no second chain is ever in the critical path of a swap",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
