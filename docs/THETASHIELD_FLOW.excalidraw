   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "What this run does and does not prove",
   "originalText": "What this run does and does not prove",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ts0322",
   "type": "text",
   "x": 1656,
   "y": 3004.25,
   "width": 780.0,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ts0319"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1566023717,
   "version": 1,
   "versionNonce": 1566023717,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1788400000000,
   "link": null,
   "locked": false,
   "text": "DOES \u2014 a real v4 swap on one chain changed the fee logic governing a later real v4 swap on that chain, with authenticated\nCircle transport both ways, a Reactive-scheduled and proxy-authenticated callback in the middle, and a measured cost for each\nleg. The final PoolManager swap charged exactly the 500-pip fee the controller expected.\n\nDOES NOT \u2014 measure real adverse selection. The reference market is ours and the operator moves it. This run proves the\nmachine, not the economics.",
   "originalText": "DOES \u2014 a real v4 swap on one chain changed the fee logic governing a later real v4 swap on that chain, with authenticated\nCircle transport both ways, a Reactive-scheduled and proxy-authenticated callback in the middle, and a measured cost for each\nleg. The final PoolManager swap charged exactly the 500-pip fee the controller expected.\n\nDOES NOT \u2014 measure real adverse selection. The reference market is ours and the operator moves it. This run proves the\nmachine, not the economics.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "ts0323",
   "type": "text",
   "x": 1656,
   "y": 3100.25,
   "width": 475.2,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "ts0319"
   ],
   "frameId": null,
   "roundness": null,
