# Copy this file to .env and fill in values locally. Never commit .env.

# Unichain Sepolia origin (Circle domain 10)
ORIGIN_CHAIN_ID=1301
ORIGIN_CIRCLE_DOMAIN=10
ORIGIN_RPC_URL=https://sepolia.unichain.org
ORIGIN_POOL_MANAGER=0x00b036B58a818B1BC34d502D3fE730Db729e62AC
ORIGIN_SWAP_ROUTER=0x9140a78c1a137C7Ff1c151Ec8231272af78a99A4
ORIGIN_MODIFY_LIQUIDITY_ROUTER=0x5fA728c0A5Cfd51BEE4b060773F50554c0C8A7aB
ORIGIN_CIRCLE_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
ORIGIN_EXPECTED_CIRCLE_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275

# Ethereum Sepolia processor (Circle domain 0)
PROCESSOR_CHAIN_ID=11155111
PROCESSOR_CIRCLE_DOMAIN=0
PROCESSOR_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PROCESSOR_CIRCLE_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
PROCESSOR_EXPECTED_CIRCLE_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275

# Reactive Network Legacy Lasna automation and Ethereum Sepolia callback target.
# These pinned values intentionally reject the temporarily unreliable Omni route.
REACTIVE_CHAIN_ID=5318007
REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev/
# Official Legacy Cron10 topic (~1 minute). Do not copy simulator placeholder topics.
REACTIVE_CRON_TOPIC=0x04463f7c1651e6b9774d7f85c85bb94654e3c46ca79b0c16fb16d4183307b687
REACTIVE_CALLBACK_GAS_LIMIT=5000000
REACTIVE_RETRY_DELAY=30
REACTIVE_MAXIMUM_RETRIES=3
# Both values remain zero until a fresh G10 spend is simulated and approved.
REACTIVE_INITIAL_FUNDING_WEI=0
PROCESSOR_REACTIVE_INITIAL_FUNDING_WEI=0
PROCESSOR_REACTIVE_CALLBACK_PROXY=0xc9f36411C9897e7F959D99ffca2a0Ba7ee0D7bDA
THETASHIELD_AUTOMATION_EXECUTOR=
THETASHIELD_AUTOMATION_RSC=

# Your deployer EOA. Both must be the SAME address or the origin and
# processor scripts revert InitialOwnerMustBeDeployer(owner, deployer).
THETASHIELD_OWNER=
DEPLOYER_ADDRESS=

# RESEARCH_V1 is the safe default. DEMO_V1 requires explicit opt-in.
THETASHIELD_PROFILE=RESEARCH_V1

# Filled from simulated/deployed outputs
THETASHIELD_CIRCLE_TRANSPORT=
THETASHIELD_CONTROLLER=
THETASHIELD_HOOK=
THETASHIELD_CIRCLE_PROCESSOR=
THETASHIELD_POOL_ID=
# Filled from the origin and processor deployment-complete events.
THETASHIELD_ORIGIN_LENS_ADDRESS=
THETASHIELD_PROCESSOR_LENS_ADDRESS=
DEMO_TOKEN0=
DEMO_TOKEN1=
REFERENCE_FEED=

# RESEARCH_V1 self-contained three-pool reference market (Ethereum Sepolia).
# Infrastructure and identifiers are release-locked; token/pool/feed addresses
# are copied from DeployCircleProcessor's deployment-complete events.
REFERENCE_POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
REFERENCE_MODIFY_LIQUIDITY_ROUTER=0x0C478023803a644c94c4CE1C1e7b9A087e411B0A
REFERENCE_SWAP_ROUTER=0x9B6b46e2c869aa39918Db7f52f5557FE577B6eEe
REFERENCE_TOKEN0=
REFERENCE_TOKEN1=
REFERENCE_POOL_ID_0=
REFERENCE_POOL_ID_1=
REFERENCE_POOL_ID_2=
REFERENCE_SOURCE_ID_0=0xc747bb9e807253c4ccaf8aadb189ab0c711fabb226ae069054f3dfe67d239a56
REFERENCE_SOURCE_ID_1=0xcd75737e198163982bf205f8ee2fd2c22cc253c1995b51d23b8ae20c4d63a4ef
REFERENCE_SOURCE_ID_2=0x2e44aa136bb8c35838d2797737aa0168f25fff8127fb150960a0439094ebbba3
REFERENCE_TEST_TOKEN_SUPPLY_WEI=100000000000000000000
REFERENCE_INITIAL_LIQUIDITY=1000000000000000000
REFERENCE_MINIMUM_LIQUIDITY=100000000000000000
REFERENCE_ACCEPTANCE_ZERO_FOR_ONE=true
REFERENCE_ACCEPTANCE_SWAP_AMOUNT=-1000000000000000

# Testnet demo parameters (REFERENCE_SOURCE_ID is DEMO_V1 only)
DEMO_TOKEN_SUPPLY_WEI=100000000000000000000
DEMO_INITIAL_LIQUIDITY=1000000000000000000
REFERENCE_MARKET_ID=0x56c48850281d506ec35fd133ed0ea59e62ee69ee1231b757f2045efd33404fe3
REFERENCE_SOURCE_ID=0x223dd42fde9425cb408a23b5e0eda69e583c29a6b759a2d0ca7501d34db9a60a
ACCEPTANCE_ZERO_FOR_ONE=true
ACCEPTANCE_SWAP_AMOUNT=-1000000000000000
ACCEPTANCE_REFERENCE_PRICE_WAD=990000000000000000
ACCEPTANCE_REFERENCE_CONFIDENCE_WAD=1000000000000000000

# One relayed message at a time. Fetch these with fetch_circle_attestation.py.
DESTINATION_CIRCLE_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
CIRCLE_MESSAGE=
CIRCLE_ATTESTATION=

# Deployment credentials (leave blank in this template)
DEPLOYER_PRIVATE_KEY=
EXPLORER_API_KEY=
