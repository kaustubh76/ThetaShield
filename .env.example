# Copy this file to .env and fill in values locally. Never commit .env.

# Unichain Sepolia origin (Circle domain 10)
ORIGIN_CHAIN_ID=1301
ORIGIN_CIRCLE_DOMAIN=10
ORIGIN_RPC_URL=https://sepolia.unichain.org
ORIGIN_POOL_MANAGER=0x00b036B58a818B1BC34d502D3fE730Db729e62AC
ORIGIN_SWAP_ROUTER=0x9140a78c1a137C7Ff1c151Ec8231272af78a99A4
ORIGIN_MODIFY_LIQUIDITY_ROUTER=0x5fA728c0A5Cfd51BEE4b060773F50554c0C8A7aB
ORIGIN_CIRCLE_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
ORIGIN_EXPECTED_CIRCLE_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275

# Ethereum Sepolia processor (Circle domain 0)
PROCESSOR_CHAIN_ID=11155111
PROCESSOR_CIRCLE_DOMAIN=0
PROCESSOR_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PROCESSOR_CIRCLE_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
PROCESSOR_EXPECTED_CIRCLE_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275

# Reactive Network automation and processor-chain callback target
REACTIVE_CHAIN_ID=5318007
REACTIVE_RPC_URL=
REACTIVE_CRON_TOPIC=
REACTIVE_CALLBACK_GAS_LIMIT=5000000
REACTIVE_RETRY_DELAY=30
REACTIVE_MAXIMUM_RETRIES=3
REACTIVE_INITIAL_FUNDING_WEI=0
PROCESSOR_REACTIVE_CALLBACK_PROXY=
THETASHIELD_AUTOMATION_EXECUTOR=
THETASHIELD_AUTOMATION_RSC=

# Public owner/deployer used for this testnet demo
THETASHIELD_OWNER=0xd1DcAAFf9356d5a42f2eE6F90179C4509386a83f
DEPLOYER_ADDRESS=0xd1DcAAFf9356d5a42f2eE6F90179C4509386a83f

# RESEARCH_V1 is the safe default. DEMO_V1 requires explicit opt-in.
THETASHIELD_PROFILE=RESEARCH_V1

# Filled from simulated/deployed outputs
THETASHIELD_CIRCLE_TRANSPORT=
THETASHIELD_CONTROLLER=
THETASHIELD_HOOK=
THETASHIELD_CIRCLE_PROCESSOR=
THETASHIELD_POOL_ID=
DEMO_TOKEN0=
DEMO_TOKEN1=
REFERENCE_FEED=

# RESEARCH_V1 three-pool reference sampler (Ethereum Sepolia)
REFERENCE_POOL_MANAGER=
REFERENCE_POOL_ID_0=
REFERENCE_POOL_ID_1=
REFERENCE_POOL_ID_2=
REFERENCE_SOURCE_ID_0=
REFERENCE_SOURCE_ID_1=
REFERENCE_SOURCE_ID_2=
REFERENCE_MINIMUM_LIQUIDITY_0=
REFERENCE_MINIMUM_LIQUIDITY_1=
REFERENCE_MINIMUM_LIQUIDITY_2=
REFERENCE_TOKEN0_DECIMALS=
REFERENCE_TOKEN1_DECIMALS=
REFERENCE_BASE_IS_TOKEN0=

# Testnet demo parameters (REFERENCE_SOURCE_ID is DEMO_V1 only)
DEMO_TOKEN_SUPPLY_WEI=100000000000000000000
DEMO_INITIAL_LIQUIDITY=1000000000000000000
REFERENCE_MARKET_ID=0x89bb3034ed6c93af18c31f974e2534634117aed6abe0ac091544668629210722
REFERENCE_SOURCE_ID=0x223dd42fde9425cb408a23b5e0eda69e583c29a6b759a2d0ca7501d34db9a60a
ACCEPTANCE_ZERO_FOR_ONE=true
ACCEPTANCE_SWAP_AMOUNT=-1000000000000000
ACCEPTANCE_REFERENCE_PRICE_WAD=990000000000000000
ACCEPTANCE_REFERENCE_CONFIDENCE_WAD=1000000000000000000

# One relayed message at a time. Fetch these with fetch_circle_attestation.py.
DESTINATION_CIRCLE_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
CIRCLE_MESSAGE=
CIRCLE_ATTESTATION=

# Deployment credentials (leave blank in this template)
DEPLOYER_PRIVATE_KEY=
EXPLORER_API_KEY=
