{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thetashield.local/schemas/deployment-manifest.schema.json",
  "title": "ThetaShield deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "source_revision",
    "created_at",
    "networks",
    "components",
    "subscriptions",
    "acceptance",
    "cost"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "mode": { "enum": ["dry-run", "live"] },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "networks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "chain_id", "rpc_secret_name"],
        "properties": {
          "role": { "enum": ["origin", "reactive", "reference"] },
          "name": { "type": "string", "minLength": 1 },
          "chain_id": { "type": "integer", "minimum": 1 },
          "rpc_secret_name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "network_role", "address", "transaction_hash", "block_number", "explorer_url", "verified"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "network_role": { "enum": ["origin", "reactive", "reference"] },
          "address": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{40}$" },
          "transaction_hash": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
          "block_number": { "type": ["integer", "null"], "minimum": 0 },
          "explorer_url": { "type": ["string", "null"], "format": "uri" },
          "verified": { "type": "boolean" }
        }
      }
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain_id", "emitter", "topic_0", "transaction_hash"],
        "properties": {
          "chain_id": { "type": "integer", "minimum": 1 },
          "emitter": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "topic_0": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "transaction_hash": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_fingerprints", "swap_transaction_hash", "callback_transaction_hash", "passed"],
      "properties": {
        "preflight_fingerprints": {
          "type": "array",
          "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
        },
        "swap_transaction_hash": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
        "callback_transaction_hash": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" },
        "passed": { "type": "boolean" }
      }
    },
    "cost": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "network_role",
          "currency",
          "gas_limit",
          "fee_cap_wei",
          "funding",
          "estimated_maximum",
          "actual",
          "approved_by_owner"
        ],
        "properties": {
          "network_role": { "enum": ["origin", "reactive", "reference"] },
          "currency": { "type": "string", "minLength": 1 },
          "gas_limit": { "type": "integer", "minimum": 0 },
          "fee_cap_wei": { "type": "string", "pattern": "^[0-9]+$" },
          "funding": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "estimated_maximum": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "actual": { "type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "approved_by_owner": { "type": "boolean" }
        }
      }
    }
  }
}
